{
  "name": "promptly",
  "version": "1.0.0",
  "description": "Full-stack Express.js + React application",
  "main": "packages/cli/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run cli:dev\" \"npm run ui:dev\"",
    "cli:dev": "cd packages/cli && node server.js",
    "ui:dev": "cd packages/ui && vite",
    "build": "cd packages/ui && vite build",
    "start": "cd packages/cli && node server.js",
    "cli:watch": "cd packages/cli && nodemon server.js"
  },
  "keywords": [
    "express",
    "react",
    "vite",
    "fullstack",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^4.4.5"
  }
}