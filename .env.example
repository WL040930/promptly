# Promptly environment template
# Copy this file to .env. Replace every required placeholder before starting the app.

# Application
PORT=3000
# Browser-facing frontend origin. Used for CORS and post-auth redirects.
CLIENT_ORIGIN=http://localhost:5173
# Canonical website origin used only by robots.txt and sitemap.xml.
# Leave unset locally.
# SITE_URL=https://app.example.com
# Public HTTPS API origin for external provider callbacks and triggers.
# Leave unset unless using a tunnel or a deployed API.
# TRIGGER_PUBLIC_ORIGIN=https://api.example.com
# Optional request-timing warning threshold, in milliseconds. Default: 750.
# PERF_SLOW_REQUEST_MS=750

# PostgreSQL (required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_DATABASE=promptly_db
# Optional pool tuning. These defaults are suitable for local development.
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=10000
DB_POOL_IDLE_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=promptly-api

# Security (required)
# Use a unique value with at least 32 characters.
JWT_SECRET=replace_with_a_unique_32_character_minimum_secret
# JWT_EXPIRES_IN=90d

# Google OAuth (required)
# Register GOOGLE_REDIRECT_URI exactly in Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Required for Gmail push triggers. Required in production for Gmail provider events.
# GOOGLE_GMAIL_PUBSUB_TOPIC=projects/your-project/topics/promptly-gmail
# GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/api/provider-events/gmail

# SMTP (required for password reset and email-delivery features)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Promptly <noreply@example.com>"
# Set to true only when intentionally logging email delivery during development.
# SEND_EMAIL_DEBUG=false

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for private workflow assets, private form uploads, and Google Drive transfers.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Both flags are enabled by default. Set one to false only to use its legacy rollout path.
# FORM_PRIVATE_UPLOADS=false
# CHAT_WORKFLOW_INVOCATIONS=false

# AI provider (required: configure a key for the selected default provider)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Supported providers: openrouter, gemini, nvidia, groq, cerebras.
# Configure only the keys you use.
# GEMINI_API_KEY=your_gemini_api_key
# NVIDIA_API_KEY=your_nvidia_api_key
# GROQ_API_KEY=your_groq_api_key
# CEREBRAS_API_KEY=your_cerebras_api_key
# OPENAI_API_KEY=your_openai_api_key

# Optional AI routing and limits
# AI_FAST_PROVIDER=openrouter
# AI_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# AI_QUALITY_PROVIDER=openrouter
# AI_QUALITY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# AI_FALLBACK_PROVIDERS=cerebras,groq
# AI_THINKING_LEVEL=minimal
# NVIDIA_ENABLE_THINKING=true
# NVIDIA_REASONING_BUDGET=16384
# AI_TIMEOUT_MS=50000
# AI_UNLIMITED_COMPLETION_TOKENS=true
# AI_MAX_COMPLETION_TOKENS=4096
# AI_FORM_UNLIMITED_COMPLETION_TOKENS=true
# AI_WORKFLOW_UNLIMITED_COMPLETION_TOKENS=true
# AI_CHAT_MAX_TOOL_LOOPS=8
# AI_AGENT_MAX_ACTIONS=8
# AI_AGENT_MAX_REPLANS=1

# Optional development diagnostics. Keep raw AI output disabled unless needed.
# AI_DIAGNOSTICS_DIR=./tmp/ai-diagnostics
# AI_DIAGNOSTICS_INCLUDE_RAW=false

# Frontend build setting. Set only when the frontend is hosted separately from the API.
# VITE_API_BASE_URL=https://api.example.com
