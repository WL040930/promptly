# Promptly local-development environment
# Copy this file to .env and replace every placeholder with a real value.

# Browser-facing frontend origin. In local development, open this address.
CLIENT_ORIGIN=http://localhost:5173

# Canonical site origin used only by robots.txt and sitemap.xml.
# Leave unset for local development. In production, set it to the real site.
# SITE_URL=https://app.example.com

# Public HTTPS origin that routes external provider callbacks to the API.
# Leave unset unless you are testing Google triggers or OAuth through a tunnel.
# TRIGGER_PUBLIC_ORIGIN=https://your-tunnel.trycloudflare.com

# Exact OAuth callback URL. It must also be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_DATABASE=promptly_db
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=10000
DB_POOL_IDLE_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_APPLICATION_NAME=promptly-api

# Security
JWT_SECRET=replace_with_at_least_32_random_characters

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Promptly <noreply@example.com>"

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for private workflow assets, private form uploads, and Drive transfers.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional rollout switches. Both are enabled by default.
# FORM_PRIVATE_UPLOADS=false
# CHAT_WORKFLOW_INVOCATIONS=false

# AI
OPENROUTER_API_KEY=your_openrouter_api_key
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENAI_API_KEY=your_openai_api_key

# Optional: use a separately hosted API from the frontend.
# VITE_API_BASE_URL=https://api.example.com
