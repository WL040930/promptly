{
  "inputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Input Data",
      "isConnection": true
    },
    {
      "name": "emailProvider",
      "type": "resource-select",
      "resource": "email-providers",
      "label": "Email Provider",
      "defaultValue": "system-default"
    },
    {
      "name": "deliveryMode",
      "type": "select",
      "label": "Send mode",
      "defaultValue": "async",
      "options": [
        { "label": "Async (recommended)", "value": "async" },
        { "label": "Wait for delivery", "value": "wait" }
      ],
      "helpText": "Async queues the email and lets the workflow continue. Choose wait only when a following step needs the provider message ID."
    },
    {
      "name": "to",
      "type": "text",
      "label": "To (recipient email)",
      "required": true,
      "valueSyntax": "workflow-expression",
      "placeholder": "user@example.com or insert data from a previous step with {}",
      "defaultValue": ""
    },
    {
      "name": "subject",
      "type": "text",
      "label": "Subject",
      "required": true,
      "valueSyntax": "workflow-expression",
      "placeholder": "Hello [Name], your order is ready — insert data from a previous step with {}",
      "defaultValue": ""
    },
    {
      "name": "body",
      "type": "textarea",
      "label": "Email Body",
      "required": true,
      "valueSyntax": "workflow-expression",
      "placeholder": "Hi [Name],\n\nYour order has shipped.\n\nBest regards — insert data from a previous step with {}",
      "defaultValue": ""
    },
    {
      "name": "htmlBody",
      "type": "textarea",
      "label": "HTML Body (optional)",
      "valueSyntax": "workflow-expression",
      "defaultValue": ""
    },
    {
      "name": "cc",
      "type": "text",
      "label": "CC (comma-separated)",
      "valueSyntax": "workflow-expression",
      "defaultValue": ""
    },
    {
      "name": "bcc",
      "type": "text",
      "label": "BCC (comma-separated)",
      "valueSyntax": "workflow-expression",
      "defaultValue": ""
    },
    {
      "name": "replyTo",
      "type": "text",
      "label": "Reply-To (optional)",
      "valueSyntax": "workflow-expression",
      "defaultValue": ""
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Output",
      "isConnection": true
    },
    {
      "name": "messageId",
      "type": "string",
      "label": "Message ID",
      "description": "The ID returned by the email provider after sending. Available only when Send mode is set to Wait for delivery."
    },
    {
      "name": "deliveryId",
      "type": "string",
      "label": "Delivery ID",
      "description": "The durable ID for an asynchronous email delivery."
    },
    {
      "name": "deliveryStatus",
      "type": "string",
      "label": "Delivery Status",
      "description": "Queued or sent."
    },
    {
      "name": "to",
      "type": "string",
      "label": "Sent To"
    },
    {
      "name": "subject",
      "type": "string",
      "label": "Subject Sent"
    }
  ]
}
