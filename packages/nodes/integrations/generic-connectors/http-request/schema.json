{
  "inputs": [
    {
      "name": "url",
      "type": "text",
      "label": "URL",
      "required": true,
      "valueSyntax": "workflow-expression",
      "placeholder": "https://api.example.com/endpoint or insert data from a previous step with {}",
      "defaultValue": ""
    },
    {
      "name": "method",
      "type": "select",
      "label": "HTTP Method",
      "defaultValue": "GET",
      "options": [
        { "label": "GET", "value": "GET" },
        { "label": "POST", "value": "POST" },
        { "label": "PUT", "value": "PUT" },
        { "label": "PATCH", "value": "PATCH" },
        { "label": "DELETE", "value": "DELETE" }
      ]
    },
    {
      "name": "headers",
      "type": "key-value",
      "label": "Request headers",
      "valueSyntax": "workflow-expression",
      "keyPlaceholder": "Header name",
      "valuePlaceholder": "Header value",
      "placeholder": "{ \"Content-Type\": \"application/json\", \"Authorization\": \"Bearer [Token]\" } or insert data from a previous step with {}",
      "defaultValue": {},
      "group": "Request"
    },
    {
      "name": "body",
      "type": "json",
      "label": "Request body",
      "valueSyntax": "workflow-expression",
      "placeholder": "{ \"key\": \"insert data from a previous step with {}\" }",
      "defaultValue": {},
      "group": "Request",
      "showWhen": { "field": "method", "notIn": ["GET", "HEAD"] }
    },
    {
      "name": "authentication",
      "type": "select",
      "label": "Authentication",
      "defaultValue": "none",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Bearer Token", "value": "bearer" },
        { "label": "API Key (Header)", "value": "apikey" },
        { "label": "Basic Auth", "value": "basic" }
      ]
    },
    {
      "name": "authToken",
      "type": "text",
      "type": "secret",
      "label": "Auth token or API key",
      "valueSyntax": "workflow-expression",
      "placeholder": "Paste a token or insert data from a previous step with {}",
      "defaultValue": "",
      "showWhen": { "field": "authentication", "notEquals": "none" },
      "requiredWhen": { "field": "authentication", "notEquals": "none" }
    },
    {
      "name": "timeout",
      "type": "number",
      "label": "Timeout (ms)",
      "defaultValue": 10000,
      "min": 100,
      "max": 60000,
      "advanced": true
    },
    {
      "name": "maxRetries",
      "type": "number",
      "label": "Maximum Retries",
      "defaultValue": 2,
      "min": 0,
      "max": 3,
      "advanced": true
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Output",
      "isConnection": true
    },
    {
      "name": "body",
      "type": "object",
      "label": "Response Body",
      "description": "The parsed response body (JSON) or raw text."
    },
    {
      "name": "statusCode",
      "type": "number",
      "label": "HTTP Status Code",
      "description": "e.g. 200, 201, 400, 404, 500"
    },
    {
      "name": "headers",
      "type": "object",
      "label": "Response Headers"
    },
    {
      "name": "ok",
      "type": "boolean",
      "label": "Success (2xx)",
      "description": "True if status code is in the 200-299 range."
    }
  ]
}
