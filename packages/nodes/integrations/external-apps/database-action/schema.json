{
  "inputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Input Payload",
      "isConnection": true
    },
    {
      "name": "resource",
      "type": "select",
      "label": "Promptly Resource",
      "required": true,
      "options": [
        { "label": "Forms", "value": "forms" },
        { "label": "Workflows", "value": "workflows" },
        { "label": "Execution Logs", "value": "executionLogs" }
      ],
      "defaultValue": "forms"
    },
    {
      "name": "operation",
      "type": "select",
      "label": "Operation",
      "required": true,
      "options": [
        { "label": "Select", "value": "select" },
        { "label": "Insert", "value": "insert" },
        { "label": "Update", "value": "update" },
        { "label": "Delete", "value": "delete" }
      ],
      "defaultValue": "select"
    },
    {
      "name": "recordId",
      "type": "resource-select",
      "resource": "promptly-records",
      "label": "Record",
      "placeholder": "Select a record…",
      "resourceParams": { "resource": "$resource" },
      "requiredResourceParams": ["resource"],
      "showWhen": { "field": "operation", "in": ["update", "delete"] },
      "requiredWhen": { "field": "operation", "in": ["update", "delete"] }
    },
    {
      "name": "filters",
      "type": "key-value",
      "label": "Find records where",
      "keyPlaceholder": "Field",
      "valuePlaceholder": "Value",
      "placeholder": "Add a field to match",
      "defaultValue": {}
    },
    {
      "name": "data",
      "type": "key-value",
      "label": "Fields to write",
      "keyPlaceholder": "Field",
      "valuePlaceholder": "New value",
      "placeholder": "Add fields to write",
      "defaultValue": {},
      "showWhen": { "field": "operation", "in": ["insert", "update"] },
      "requiredWhen": { "field": "operation", "in": ["insert", "update"] }
    },
    {
      "name": "limit",
      "type": "number",
      "label": "Read Limit",
      "defaultValue": 50,
      "min": 1,
      "max": 100
    },
    {
      "name": "orderBy",
      "type": "text",
      "label": "Order Field",
      "defaultValue": "updatedAt"
    },
    {
      "name": "orderDirection",
      "type": "select",
      "label": "Order Direction",
      "options": ["ASC", "DESC"],
      "defaultValue": "DESC"
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Database Result",
      "isConnection": true
    }
  ]
}
