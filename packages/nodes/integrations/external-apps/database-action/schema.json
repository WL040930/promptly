{
  "inputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Input Payload",
      "isConnection": true
    },
    {
      "name": "resource",
      "type": "select",
      "label": "Promptly Resource",
      "required": true,
      "options": [
        { "label": "Forms", "value": "forms" },
        { "label": "Workflows", "value": "workflows" },
        { "label": "Execution Logs", "value": "executionLogs" }
      ],
      "defaultValue": "forms"
    },
    {
      "name": "operation",
      "type": "select",
      "label": "Operation",
      "required": true,
      "options": [
        { "label": "Select", "value": "select" },
        { "label": "Insert", "value": "insert" },
        { "label": "Update", "value": "update" },
        { "label": "Delete", "value": "delete" }
      ],
      "defaultValue": "select"
    },
    {
      "name": "filters",
      "type": "object",
      "label": "Filters (JSON)",
      "placeholder": "{ \"id\": \"form_...\" }",
      "defaultValue": {}
    },
    {
      "name": "data",
      "type": "object",
      "label": "Data (JSON)",
      "placeholder": "{ \"title\": \"Updated title\" }",
      "defaultValue": {}
    },
    {
      "name": "limit",
      "type": "number",
      "label": "Read Limit",
      "defaultValue": 50
    },
    {
      "name": "orderBy",
      "type": "text",
      "label": "Order Field",
      "defaultValue": "updatedAt"
    },
    {
      "name": "orderDirection",
      "type": "select",
      "label": "Order Direction",
      "options": ["ASC", "DESC"],
      "defaultValue": "DESC"
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Database Result",
      "isConnection": true
    }
  ]
}
