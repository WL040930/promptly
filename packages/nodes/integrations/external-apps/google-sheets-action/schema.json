{
  "inputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Input Payload",
      "isConnection": true
    },
    {
      "name": "spreadsheetId",
      "type": "resource-select",
      "resource": "google-spreadsheets",
      "label": "Spreadsheet",
      "required": true,
      "placeholder": "Select a spreadsheet…",
      "allowCustom": true,
      "customLabel": "Paste spreadsheet URL or ID",
      "valueFormat": "google-spreadsheet-id"
    },
    {
      "name": "range",
      "type": "resource-select",
      "resource": "google-sheet-ranges",
      "label": "Sheet and range",
      "required": true,
      "placeholder": "Select a sheet…",
      "requiredResourceParams": ["spreadsheetId"],
      "resourceParams": { "spreadsheetId": "$spreadsheetId" },
      "allowCustom": true,
      "customLabel": "Enter a custom range"
    },
    {
      "name": "operation",
      "type": "select",
      "label": "Operation",
      "required": true,
      "options": [
        { "label": "Read", "value": "read" },
        { "label": "Append Rows", "value": "append" },
        { "label": "Update Range", "value": "update" },
        { "label": "Clear Range", "value": "clear" }
      ],
      "defaultValue": "read",
      "group": "Operation"
    },
    {
      "name": "values",
      "type": "data-grid",
      "label": "Rows to write",
      "placeholder": "Add values row by row",
      "defaultValue": [],
      "showWhen": { "field": "operation", "in": ["append", "update"] },
      "requiredWhen": { "field": "operation", "in": ["append", "update"] }
    },
    {
      "name": "valueInputOption",
      "type": "select",
      "label": "Input Mode",
      "options": ["RAW", "USER_ENTERED"],
      "defaultValue": "USER_ENTERED",
      "showWhen": { "field": "operation", "in": ["append", "update"] },
      "group": "Operation"
    },
    {
      "name": "valueRenderOption",
      "type": "select",
      "label": "Read Value Mode",
      "options": ["FORMATTED_VALUE", "UNFORMATTED_VALUE", "FORMULA"],
      "defaultValue": "UNFORMATTED_VALUE",
      "showWhen": { "field": "operation", "equals": "read" },
      "group": "Operation"
    },
    {
      "name": "includeValuesInResponse",
      "type": "boolean",
      "label": "Include Written Values",
      "defaultValue": false,
      "showWhen": { "field": "operation", "in": ["append", "update"] },
      "group": "Operation"
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Google Sheets Result",
      "isConnection": true
    }
  ]
}
