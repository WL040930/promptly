{
  "inputs": [
    {
      "name": "prompt",
      "type": "textarea",
      "label": "Image Prompt",
      "valueSyntax": "workflow-expression",
      "placeholder": "A photorealistic image of... Insert data from a previous step with {}.",
      "defaultValue": ""
    },
    {
      "name": "model",
      "type": "select",
      "label": "Model",
      "defaultValue": "dall-e-3",
      "options": [
        { "label": "DALL-E 3 (OpenAI)", "value": "dall-e-3" },
        { "label": "DALL-E 2 (OpenAI)", "value": "dall-e-2" },
        { "label": "Stable Diffusion XL", "value": "sdxl" },
        { "label": "Stable Diffusion 3", "value": "sd3" }
      ]
    },
    {
      "name": "size",
      "type": "select",
      "label": "Image Size",
      "defaultValue": "1024x1024",
      "options": [
        { "label": "Square — 1024×1024", "value": "1024x1024" },
        { "label": "Landscape — 1792×1024", "value": "1792x1024" },
        { "label": "Portrait — 1024×1792", "value": "1024x1792" },
        { "label": "Small — 512×512", "value": "512x512" },
        { "label": "Tiny — 256×256", "value": "256x256" }
      ]
    },
    {
      "name": "quality",
      "type": "select",
      "label": "Quality (DALL-E 3 only)",
      "defaultValue": "standard",
      "options": [
        { "label": "Standard", "value": "standard" },
        { "label": "HD", "value": "hd" }
      ]
    },
    {
      "name": "style",
      "type": "select",
      "label": "Style (DALL-E 3 only)",
      "defaultValue": "vivid",
      "options": [
        { "label": "Vivid (dramatic, hyper-real)", "value": "vivid" },
        { "label": "Natural (less dramatic)", "value": "natural" }
      ]
    },
    {
      "name": "n",
      "type": "number",
      "label": "Number of Images",
      "defaultValue": 1
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Output",
      "isConnection": true
    },
    {
      "name": "imageUrl",
      "type": "string",
      "label": "Image URL",
      "description": "The URL of the generated image."
    },
    {
      "name": "revisedPrompt",
      "type": "string",
      "label": "Revised Prompt",
      "description": "The prompt actually used by the model (DALL-E 3 may revise it)."
    },
    {
      "name": "model",
      "type": "string",
      "label": "Model Used"
    }
  ]
}
