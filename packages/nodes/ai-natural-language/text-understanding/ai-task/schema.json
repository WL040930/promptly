{
  "inputs": [
    { "name": "inputData", "type": "object", "label": "Input Data", "isConnection": true },
    {
      "name": "taskType",
      "type": "select",
      "label": "Task type",
      "group": "Task",
      "helpText": "Choose the result you want this step to produce.",
      "defaultValue": "custom",
      "options": [
        { "label": "Custom prompt", "value": "custom" },
        { "label": "Summarize", "value": "summarize" },
        { "label": "Extract structured data", "value": "extract" },
        { "label": "Analyze sentiment", "value": "sentiment" },
        { "label": "Categorize", "value": "categorize" }
      ]
    },
    {
      "name": "prompt",
      "type": "textarea",
      "label": "Instructions",
      "group": "Instructions",
      "valueSyntax": "node-template",
      "placeholder": "Describe what the AI should do. Insert data from a previous step with the {} button.",
      "defaultValue": "",
      "helpText": "If left blank, the connected input data is used directly."
    },
    {
      "name": "extractionSchema",
      "type": "json",
      "label": "Fields to extract",
      "group": "Instructions",
      "placeholder": "{ \"name\": \"string\", \"email\": \"string\", \"amount\": \"number\" }",
      "defaultValue": {},
      "showWhen": { "field": "taskType", "equals": "extract" },
      "requiredWhen": { "field": "taskType", "equals": "extract" },
      "helpText": "Describe the JSON fields the AI must return."
    },
    {
      "name": "categories",
      "type": "string-list",
      "label": "Categories",
      "group": "Instructions",
      "placeholder": "Type a category and press Enter",
      "defaultValue": [],
      "showWhen": { "field": "taskType", "equals": "categorize" },
      "requiredWhen": { "field": "taskType", "equals": "categorize" },
      "suggestions": ["sales", "support", "billing", "other"]
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Response mode",
      "group": "Model",
      "advanced": true,
      "defaultValue": "best",
      "options": [
        { "label": "Fast", "value": "fast" },
        { "label": "Best quality", "value": "best" }
      ]
    },
    {
      "name": "systemPrompt",
      "type": "textarea",
      "label": "System instructions",
      "group": "Model",
      "advanced": true,
      "valueSyntax": "node-template",
      "placeholder": "Optional role, tone, or rules for the AI.",
      "defaultValue": ""
    }
  ],
  "outputs": [
    { "name": "outputData", "type": "object", "label": "Output", "isConnection": true },
    { "name": "response", "type": "string", "label": "AI Response", "description": "The text or JSON output from the AI model." },
    { "name": "taskType", "type": "string", "label": "Task Type Used" },
    { "name": "tokensUsed", "type": "number", "label": "Tokens Used" },
    { "name": "model", "type": "string", "label": "Model Used" }
  ]
}
