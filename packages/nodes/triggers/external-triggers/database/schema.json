{
  "inputs": [
    {
      "name": "resource",
      "type": "select",
      "label": "Promptly Resource",
      "required": true,
      "options": ["forms", "workflows", "executionLogs"],
      "defaultValue": "forms"
    },
    {
      "name": "events",
      "type": "string-list",
      "label": "Events to watch",
      "suggestions": ["created", "updated", "deleted"],
      "defaultValue": ["created", "updated", "deleted"]
    },
    {
      "name": "filters",
      "type": "key-value",
      "label": "Only when fields match",
      "keyPlaceholder": "Field",
      "valuePlaceholder": "Value",
      "defaultValue": {}
    },
    {
      "name": "ignoreOwnWorkflowChanges",
      "type": "boolean",
      "label": "Ignore Own Execution Changes",
      "defaultValue": true
    }
  ],
  "outputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Trigger Data",
      "isConnection": true,
      "description": "Data received from the trigger event."
    }
  ]
}
