{
  "inputs": [
    {
      "name": "spreadsheetId",
      "type": "text",
      "label": "Spreadsheet ID",
      "required": true,
      "placeholder": "ID from the Google Sheets URL"
    },
    {
      "name": "range",
      "type": "text",
      "label": "Watched Range",
      "required": true,
      "placeholder": "Sheet1!A:Z"
    },
    {
      "name": "baselineMode",
      "type": "select",
      "label": "Initial Rows",
      "options": ["ignore-existing", "process-existing"],
      "defaultValue": "ignore-existing"
    }
  ],
  "outputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Trigger Data",
      "isConnection": true,
      "description": "Data received from the trigger event."
    }
  ]
}
