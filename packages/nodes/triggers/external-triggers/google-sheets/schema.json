{
  "inputs": [
    {
      "name": "spreadsheetId",
      "type": "resource-select",
      "resource": "google-spreadsheets",
      "label": "Spreadsheet",
      "required": true,
      "placeholder": "Select a spreadsheet…",
      "allowCustom": true,
      "customLabel": "Paste spreadsheet URL or ID",
      "valueFormat": "google-spreadsheet-id"
    },
    {
      "name": "range",
      "type": "resource-select",
      "resource": "google-sheet-ranges",
      "label": "Watched sheet and range",
      "required": true,
      "placeholder": "Select a sheet…",
      "requiredResourceParams": ["spreadsheetId"],
      "resourceParams": { "spreadsheetId": "$spreadsheetId" },
      "allowCustom": true,
      "customLabel": "Enter a custom range"
    },
    {
      "name": "baselineMode",
      "type": "select",
      "label": "Initial Rows",
      "options": ["ignore-existing", "process-existing"],
      "defaultValue": "ignore-existing"
    }
  ],
  "outputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Trigger Data",
      "isConnection": true,
      "description": "Data received from the trigger event."
    }
  ]
}
