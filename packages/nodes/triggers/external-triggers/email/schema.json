{
  "inputs": [
    {
      "name": "labels",
      "type": "object",
      "label": "Gmail Labels (JSON array)",
      "defaultValue": ["INBOX"]
    },
    {
      "name": "fromContains",
      "type": "text",
      "label": "Sender Contains",
      "defaultValue": ""
    },
    {
      "name": "subjectContains",
      "type": "text",
      "label": "Subject Contains",
      "defaultValue": ""
    },
    {
      "name": "hasAttachment",
      "type": "select",
      "label": "Attachment Filter",
      "options": ["any", "true", "false"],
      "defaultValue": "any"
    },
    {
      "name": "includeBody",
      "type": "select",
      "label": "Include Message Body",
      "options": ["false", "true"],
      "defaultValue": "false"
    }
  ],
  "outputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Trigger Data",
      "isConnection": true,
      "description": "Data received from the trigger event."
    }
  ]
}
