{
  "inputs": [
    {
      "name": "labels",
      "type": "string-list",
      "label": "Gmail labels",
      "suggestions": ["INBOX", "STARRED", "IMPORTANT"],
      "defaultValue": ["INBOX"]
    },
    {
      "name": "fromContains",
      "type": "text",
      "label": "Sender Contains",
      "defaultValue": ""
    },
    {
      "name": "subjectContains",
      "type": "text",
      "label": "Subject Contains",
      "defaultValue": ""
    },
    {
      "name": "hasAttachment",
      "type": "select",
      "label": "Attachment Filter",
      "options": [
        { "label": "Any", "value": "any" },
        { "label": "Has an attachment", "value": "true" },
        { "label": "No attachment", "value": "false" }
      ],
      "defaultValue": "any"
    },
    {
      "name": "includeBody",
      "type": "boolean",
      "label": "Include Message Body",
      "defaultValue": false
    }
  ],
  "outputs": [
    {
      "name": "triggerData",
      "type": "object",
      "label": "Trigger Data",
      "isConnection": true,
      "description": "Data received from the trigger event."
    }
  ]
}
