{
  "inputs": [
    {
      "name": "input1",
      "type": "object",
      "label": "Input Data",
      "isConnection": true
    },
    {
      "name": "waitMode",
      "type": "select",
      "label": "Wait mode",
      "defaultValue": "duration",
      "options": [
        { "label": "For a duration", "value": "duration" },
        { "label": "Until a date and time", "value": "until" }
      ]
    },
    {
      "name": "delayAmount",
      "type": "number",
      "label": "Delay Amount",
      "defaultValue": 1,
      "min": 0,
      "max": 8760,
      "showWhen": { "field": "waitMode", "equals": "duration" }
    },
    {
      "name": "resumeAt",
      "type": "text",
      "label": "Resume at",
      "placeholder": "2026-12-31T09:00:00+08:00",
      "showWhen": { "field": "waitMode", "equals": "until" },
      "requiredWhen": { "field": "waitMode", "equals": "until" }
    },
    {
      "name": "delayUnit",
      "type": "select",
      "label": "Delay Unit",
      "defaultValue": "seconds",
      "options": [
        { "label": "Milliseconds", "value": "milliseconds" },
        { "label": "Seconds", "value": "seconds" },
        { "label": "Minutes", "value": "minutes" },
        { "label": "Hours", "value": "hours" }
      ]
    }
  ],
  "outputs": [
    {
      "name": "outputData",
      "type": "object",
      "label": "Output Data",
      "isConnection": true
    }
  ]
}
