{
  "inputs": [
    { "name": "input1", "type": "object", "label": "Input Data", "isConnection": true },
    {
      "name": "dataType",
      "type": "select",
      "label": "Data type",
      "group": "Transform",
      "defaultValue": "text",
      "options": [
        { "label": "Text", "value": "text" },
        { "label": "Number", "value": "number" },
        { "label": "Date", "value": "date" },
        { "label": "JSON or object", "value": "json" }
      ]
    },
    {
      "name": "operation",
      "type": "select",
      "label": "Operation",
      "group": "Transform",
      "defaultValue": "uppercase",
      "optionsBy": {
        "field": "dataType",
        "values": {
          "text": [
            { "label": "Uppercase", "value": "uppercase" },
            { "label": "Lowercase", "value": "lowercase" },
            { "label": "Title case", "value": "titlecase" },
            { "label": "Trim whitespace", "value": "trim" },
            { "label": "Find and replace", "value": "replace" },
            { "label": "Split into a list", "value": "split" },
            { "label": "Extract part of text", "value": "slice" }
          ],
          "number": [
            { "label": "Add", "value": "add" },
            { "label": "Subtract", "value": "subtract" },
            { "label": "Multiply", "value": "multiply" },
            { "label": "Divide", "value": "divide" },
            { "label": "Round", "value": "round" },
            { "label": "Round down", "value": "floor" },
            { "label": "Round up", "value": "ceil" },
            { "label": "Absolute value", "value": "abs" },
            { "label": "Fixed decimal places", "value": "toFixed" }
          ],
          "date": [
            { "label": "Format date", "value": "formatDate" },
            { "label": "Add days", "value": "addDays" },
            { "label": "Subtract days", "value": "subtractDays" },
            { "label": "Current timestamp", "value": "now" }
          ],
          "json": [
            { "label": "Parse JSON text", "value": "parse" },
            { "label": "Convert to JSON text", "value": "stringify" },
            { "label": "Get a nested value", "value": "get" },
            { "label": "Set a nested value", "value": "set" },
            { "label": "Get object keys", "value": "keys" }
          ]
        }
      }
    },
    {
      "name": "value",
      "type": "text",
      "label": "Input value",
      "group": "Input",
      "placeholder": "Enter a value or insert data from a previous step",
      "defaultValue": "",
      "showWhen": { "field": "operation", "notIn": ["now"] },
      "requiredWhen": { "field": "operation", "notIn": ["now"] }
    },
    {
      "name": "operand",
      "type": "text",
      "label": "Second value",
      "group": "Input",
      "placeholder": "The number, separator, path, or replacement to use",
      "defaultValue": "",
      "showWhen": { "field": "operation", "in": ["replace", "split", "slice", "add", "subtract", "multiply", "divide", "formatDate", "addDays", "subtractDays", "get", "set"] },
      "requiredWhen": { "field": "operation", "in": ["replace", "slice", "divide", "formatDate", "get", "set"] },
      "helpText": "For find and replace, use find|replacement. For slicing, use start:end."
    },
    {
      "name": "decimals",
      "type": "number",
      "label": "Decimal places",
      "group": "Input",
      "defaultValue": 2,
      "min": 0,
      "max": 20,
      "showWhen": { "field": "operation", "equals": "toFixed" }
    },
    {
      "name": "timezone",
      "type": "select",
      "label": "Timezone",
      "group": "Input",
      "defaultValue": "UTC",
      "options": [
        { "label": "UTC", "value": "UTC" },
        { "label": "Kuala Lumpur (UTC+8)", "value": "Asia/Kuala_Lumpur" },
        { "label": "Singapore (UTC+8)", "value": "Asia/Singapore" },
        { "label": "Tokyo (UTC+9)", "value": "Asia/Tokyo" },
        { "label": "London", "value": "Europe/London" },
        { "label": "New York", "value": "America/New_York" },
        { "label": "Los Angeles", "value": "America/Los_Angeles" }
      ],
      "showWhen": { "field": "operation", "equals": "formatDate" }
    }
  ],
  "outputs": [
    { "name": "outputData", "type": "object", "label": "Output", "isConnection": true },
    { "name": "result", "type": "any", "label": "Transformed Result", "description": "The transformed value." },
    { "name": "outputType", "type": "string", "label": "Output Type" },
    { "name": "inputValue", "type": "string", "label": "Original Input Value" }
  ]
}
